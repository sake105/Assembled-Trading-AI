# Staging environment template — Alpaca Paper account
# Copy to .env.staging and fill in your Paper API keys (gitignored)
ATA_ENVIRONMENT=staging
ATA_TRADING_MODE=paper
ATA_LOG_LEVEL=INFO
ATA_ENABLE_NEWS_FEATURES=true
ATA_ENABLE_SHADOW_MODE=true

# Risk limits — moderate for staging
ATA_RISK_MAX_POSITION_USD=5000
ATA_RISK_MAX_DAILY_LOSS_USD=500
ATA_RISK_MAX_OPEN_POSITIONS=20
ATA_RISK_KILL_SWITCH_LOSS_USD=2000

# Alpaca Paper credentials (from app.alpaca.markets → Paper account)
ATA_ALPACA_API_KEY=your_paper_api_key_here  # pragma: allowlist secret
ATA_ALPACA_SECRET_KEY=your_paper_secret_key_here  # pragma: allowlist secret
ATA_ALPACA_BASE_URL=https://paper-api.alpaca.markets/

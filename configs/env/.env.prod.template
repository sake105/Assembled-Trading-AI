# Prod environment template — Alpaca Live account
# NEVER commit the actual .env.prod file. Use SOPS+age encryption instead.
# Minimum 7 days stable in staging before promoting to prod.
ATA_ENVIRONMENT=prod
ATA_TRADING_MODE=live
ATA_LOG_LEVEL=WARNING
ATA_ENABLE_NEWS_FEATURES=true
ATA_ENABLE_SHADOW_MODE=false

# Risk limits — conservative for prod
ATA_RISK_MAX_POSITION_USD=10000
ATA_RISK_MAX_DAILY_LOSS_USD=1000
ATA_RISK_MAX_OPEN_POSITIONS=30
ATA_RISK_KILL_SWITCH_LOSS_USD=5000

# Alpaca Live credentials (from app.alpaca.markets → Live account)
ATA_ALPACA_API_KEY=your_live_api_key_here  # pragma: allowlist secret
ATA_ALPACA_SECRET_KEY=your_live_secret_key_here  # pragma: allowlist secret
ATA_ALPACA_BASE_URL=https://api.alpaca.markets/

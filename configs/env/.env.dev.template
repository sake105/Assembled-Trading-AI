# Dev environment template — no real API keys needed
# Copy to .env.dev and fill in if needed (usually not required for dev)
ATA_ENVIRONMENT=dev
ATA_TRADING_MODE=mock
ATA_LOG_LEVEL=DEBUG
ATA_ENABLE_NEWS_FEATURES=true
ATA_ENABLE_SHADOW_MODE=false

# Risk limits — permissive for dev (small USD values, won't touch real $)
ATA_RISK_MAX_POSITION_USD=100
ATA_RISK_MAX_DAILY_LOSS_USD=50
ATA_RISK_MAX_OPEN_POSITIONS=5
ATA_RISK_KILL_SWITCH_LOSS_USD=200

# Alpaca — not required in mock mode
# ATA_ALPACA_API_KEY=
# ATA_ALPACA_SECRET_KEY=
# ATA_ALPACA_BASE_URL=https://paper-api.alpaca.markets/

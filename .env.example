# .env.example — Assembled-Trading-AI
# Copy to .env and fill in real values. Never commit .env to git.
# See src/assembled_core/config/env_validator.py for required vs optional vars.

# =============================================================================
# BROKER — Alpaca
# =============================================================================

# Alpaca paper-trading API key (alpaca.markets → paper account)
ALPACA_API_KEY=your_alpaca_api_key_here

# Alpaca API secret — used by broker_adapter.py
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Legacy alias (referenced by run_paper_live.py docstring and start_pilot_v2.ps1).
# broker_adapter.py (canonical) reads ALPACA_API_SECRET above — leave this blank
# unless you specifically run start_pilot_v2.ps1, which still requires this name.
ALPACA_SECRET_KEY=

# Alpaca base URL — paper: https://paper-api.alpaca.markets, live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Set to "true" only to enable live (real-money) trading; leave blank for paper mode
ALPACA_ALLOW_LIVE=

# =============================================================================
# DATA SOURCES
# =============================================================================

# -----------------------------------------------------------------------------
# Multi-key rotation (2026-05-22): the five keyed providers below
# (Alpha Vantage, Polygon, NewsAPI, Finnhub, FRED) all support a pool of N
# keys via the central api_key_rotator (src/assembled_core/utils/api_key_rotator.py).
# On 429/rate-limit, the rotator marks the current key cooled-down and
# returns the next available one. Two equivalent forms supported per provider:
#
#   Form A (numbered, recommended for .env clarity):
#       FINNHUB_API_KEY=key1
#       FINNHUB_API_KEY_2=key2
#       FINNHUB_API_KEY_3=key3
#
#   Form B (comma-separated):
#       FINNHUB_API_KEYS="k1,k2,k3"  # pragma: allowlist secret
#
# Single-key callers stay backward compatible: when only the canonical
# _API_KEY var is set, the rotator pool has 1 key and behaves identically
# to the prior single-key path.
# -----------------------------------------------------------------------------

# Finnhub API key — news, earnings, events (assembled_core canonical name)
ASSEMBLED_FINNHUB_API_KEY=your_finnhub_api_key_here

# Finnhub key also referenced directly in some scripts (rotator canonical)
FINNHUB_API_KEY=your_finnhub_api_key_here
# Additional Finnhub keys for rotation (uncomment + fill as you obtain them):
# FINNHUB_API_KEY_2=
# FINNHUB_API_KEY_3=
# FINNHUB_API_KEYS=

# Alpha Vantage key — daily OHLCV via alphavantage_source.py AND earnings via
# earnings_calendar_source.py. Canonical name across the codebase.
ALPHAVANTAGE_KEY=your_alphavantage_key_here

# Legacy alias — earnings_calendar_source.py reads this as a fallback only.
# Leave blank if ALPHAVANTAGE_KEY is set above.
ALPHAVANTAGE_API_KEY=
# Additional Alpha Vantage keys for rotation (uncomment + fill as you obtain them):
# ALPHAVANTAGE_API_KEY_2=
# ALPHAVANTAGE_API_KEY_3=
# ALPHAVANTAGE_API_KEYS=

# Twelve Data API key — price data fallback
ASSEMBLED_TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# SEC EDGAR User-Agent — REQUIRED by SEC fair-access policy for the free Form 4
# insider ingester (edgar_form4_ingest). Must be a real org + contact email;
# an undeclared UA returns HTTP 403. Not a secret, but must be set.
SEC_USER_AGENT="Assembled-Trading-AI your_email@example.com"

# Polygon.io API key — price and news data
POLYGON_API_KEY=your_polygon_api_key_here
# Additional Polygon keys for rotation (uncomment + fill as you obtain them):
# POLYGON_API_KEY_2=
# POLYGON_API_KEY_3=
# POLYGON_API_KEYS=

# NewsAPI.org key — news pipeline
NEWSAPI_KEY=your_newsapi_key_here
# Additional NewsAPI keys for rotation (uncomment + fill as you obtain them):
# NEWSAPI_API_KEY_2=
# NEWSAPI_API_KEY_3=
# NEWSAPI_API_KEYS=
#
# NOTE on NewsAPI multi-key (2026-05-22): NEWSAPI_DAILY_LIMIT (default 100,
# matching the free-tier daily cap) is tracked process-wide in
# .newsapi_call_counter.json — it does NOT increase automatically when you
# add KEY_2/KEY_3. If you run a pool of N keys, set NEWSAPI_DAILY_LIMIT
# to 100 × N so the counter stops blocking once a single-key quota is hit.
# Per-key counter tracking is a planned follow-up; not in this release.
# NEWSAPI_DAILY_LIMIT=200

# FRED (St. Louis Fed) API key — macro data (GDP, CPI, VIX, GPR).
# Rotator-aware: add FRED_API_KEY_2, FRED_API_KEY_3, ... or FRED_API_KEYS
# for multi-key pooling (free tier is 120 req/min, generous but bounded).
FRED_API_KEY=your_fred_api_key_here
# FRED_API_KEY_2=
# FRED_API_KEY_3=
# FRED_API_KEYS=

# NOAA Climate Data Online token — weather/climate features
NOAA_CDO_TOKEN=your_noaa_cdo_token_here

# Anthropic API key — Claude-powered news summarization and RAG components
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# MONITORING & ALERTING
# =============================================================================

# Sentry DSN — error tracking (leave blank to disable)
SENTRY_DSN=your_sentry_dsn_here

# Discord webhook URL for trade/alert notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Discord webhook alternate name used in some alerting modules
DISCORD_WEBHOOK=your_discord_webhook_here

# Telegram bot token — alert channel
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID — target chat/channel for alerts
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Alert email recipient address
ALERT_EMAIL_TO=your_alert_email@example.com

# SMTP credentials for email alerts
SMTP_HOST=smtp.example.com
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here

# MLflow tracking server URI (leave blank to use local ./mlruns)
MLFLOW_TRACKING_URI=

# =============================================================================
# INFRASTRUCTURE (QuestDB, Redis)
# =============================================================================

# QuestDB connection settings — time-series tick store
QUESTDB_HOST=localhost
QUESTDB_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASS=your_questdb_password_here
QUESTDB_DB=assembled
# Connect timeout in seconds. Optional — LEAVE UNSET unless you have a reason;
# the built-in default (3.0s) is the desired state, and it is deliberately NOT
# in env_validator.OPTIONAL_VARS so an unset value stays silent (Rule 80).
# Accepted range (0, 30]; anything else falls back to the default — the
# unbounded connect of E-063 cannot be restored via this variable.
# QUESTDB_CONNECT_TIMEOUT_S=3.0

# Redis URL — EventBus side-channel and caching layer
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SYSTEM / RUNTIME
# =============================================================================

# Runtime environment: paper | live | backtest | research
ATA_ENVIRONMENT=paper

# Alternative environment flag (settings.py)
ENVIRONMENT=paper

# Runtime profile: development | production | ci
ASSEMBLED_RUNTIME_PROFILE=development

# API key for command endpoints (kill-switch, paper orders, paper reset).
# Sent by clients as the X-API-Key header. Read (GET) endpoints stay open.
# Leave blank in dev/test (endpoints fall open with a warning). In production
# this MUST be set, otherwise the API fails closed (HTTP 503) — see below.
ASSEMBLED_API_KEY=

# Force fail-closed auth even outside a production profile: when "1"/"true" and
# ASSEMBLED_API_KEY is unset, command endpoints return 503 instead of falling
# open. Auth is also forced closed automatically when ASSEMBLED_RUNTIME_PROFILE
# is production/prod/live. Leave blank for dev/test fail-open (SEC-1).
ASSEMBLED_API_REQUIRE_AUTH=

# Path to policy.yaml override (defaults to configs/policy.yaml)
ASSEMBLED_POLICY_PATH=

# Local data root override (defaults to ./output if unset)
ASSEMBLED_LOCAL_DATA_ROOT=

# Feature store path override
FEATURE_STORE_PATH=

# Kill-switch — set to "1" to halt all trading immediately
ASSEMBLED_KILL_SWITCH=0

# Kill-switch operator token — REQUIRED to call deactivate_kill_switch().
# Must be set before starting the API or running preflight/drills.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep secret: never commit the real value.
OPERATOR_KILL_TOKEN=

# Kill-switch audit logging toggle
ASSEMBLED_KILL_SWITCH_AUDIT=0

# Kill-switch sentinel value (internal state token — do not set manually)
ASSEMBLED_KILL_SWITCH_SENTINEL=

# Kill-switch persistence state file path (internal — do not set manually)
ASSEMBLED_KILL_SWITCH_STATE=

# Risk state persistence mode: memory | file | redis
ASSEMBLED_RISK_STATE_PERSISTENCE_MODE=memory

# Unique run ID for reproducibility tracking (auto-generated if blank)
ASSEMBLED_RUN_ID=

# Enable strict PIT (point-in-time) data checks: 1 | 0
ASSEMBLED_STRICT_PIT_CHECKS=1

# Strict PIT checks for paper tracking mode
PAPER_TRACK_STRICT_PIT=1
PAPER_TRACK_STRICT_PIT_CHECKS=1

# Enable paper mode flag
PAPER=1

# PDT (Pattern Day Trader) rule enforcement: 1 | 0
PDT_RULE_ACTIVE=1

# Strict quantity enforcement in execution layer: 1 | 0
AS_CORE_STRICT_QTY=1

# Python hash seed — set to a fixed integer for reproducible runs
PYTHONHASHSEED=42

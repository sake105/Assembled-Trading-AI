# Python & Venv
.venv/
__pycache__/
*.pyc

# Data & Outputs
/data/
/output/
logs/
# Raw ML data pulls (multi-GB, never commit) — already covered by /data/ above,
# listed explicitly for clarity (PIT as-of-filing snapshots, 2026-06-10).
data/raw/insider_congress/
data/raw/fundamentals/

# Archive & Legacy
# archive/ is now tracked — contains research code moved out of src/ (2026-04-19)
legacy/
backup/

# Binary Archives
*.zip
*.7z
*.rar
*.tar.gz
*.tar.bz2

# Log Files
*.log
*_run.log
_screener_run.log

# Temporary Files
tmp_*.py
*.tmp
*.bak

# Large Documents (optional - behalten wenn wichtig)
# *.docx
# *.xlsx

# Secrets & Environment Variables
.env
.env.*
!.env.example
# F-senior-4: template files in configs/env/ must be tracked (single source of
# truth for env-var contract). Exclude them from the .env.* gitignore pattern.
!configs/env/*.template
*.env
.env.local
.env.dev
.env.prod

# Profile / Benchmark outputs
*profile_out*.txt
*.prof
benchmark_output_*.txt
profile_*.json

# OS/Tools
.DS_Store
Thumbs.db
src/assembled_trading_core.egg-info/

# System-Check Tournament runs (keep directory, ignore individual runs)
system_check/runs/*/
!system_check/runs/.gitkeep

# Claude Code runtime artifacts
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/worktrees/

# CI / debugging investigation artifacts (root-level scratch)
/ci_*.json
/jobs_*.json

# Model artifacts (not versioned — use Git LFS or external storage if needed)
/models/
!/models/registry.json

# Historical price data — not versioned; download via scripts/download_all_universes_robust.py
# Exception: tests/fixtures/*.parquet (small smoke-test fixtures) are tracked
datensammlungen/**/*.parquet
!tests/fixtures/*.parquet

# Research data pulls — code/results/reports ARE tracked (W16, 2026-07-23),
# the bulk price/filing parquets are re-pullable (research/mandat/pull_eodhd_verdict.py
# bzw. fable mill scripts) and stay out of git (~4.1 GB in mandat/data alone).
research/mandat/data/
research/fable_exploration/**/*.parquet
research/**/__pycache__/

# Legacy singular config/ dir — merged into configs/ on 2026-04-25
# Prevents accidental re-creation of the old split
/config/
*profile_out*.txt
*.prof

# Coverage artifacts
.coverage
coverage.xml
htmlcov/

# Local planning docs
autonome_weiterarbeit/

autonomous/

# Review-chain runtime state (per-turn markers + skip audit, not source)
.claude/.review_markers/
.claude/.review_skip
.claude/.review_skip_log.jsonl

# protected_paths_guard.py runtime state (diagnostic log + one-shot override token + audit log)
.claude/.hook_diag.jsonl
.claude/.destructive_bash_authorized
.claude/.destructive_bash_auth_log.jsonl

# QA backtest bootstrap artifacts (regenerable, produced by backtest_engine.py)
qa/bootstrap_*.json

# Experiment run artifacts (regenerable, timestamped run dirs from experiment_tracker)
experiments/*/run.json

# System map design/screenshot scratchpad (local UI research, not tracked)
docs/architecture/system_map/screenshots/

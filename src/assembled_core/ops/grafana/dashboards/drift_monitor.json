{
  "title": "Assembled Trading — Drift Monitor",
  "uid": "assembled-drift-monitor",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "tags": ["assembled", "trading", "drift", "psi"],
  "panels": [
    {
      "id": 1,
      "title": "Max PSI (all features)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "description": "Maximum PSI across all features. >0.2 = warning, >0.35 = critical.",
      "targets": [
        {
          "expr": "max(assembled_drift_max_psi) by (strategy)",
          "legendFormat": "{{strategy}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": null, "color": "green" },
            { "value": 0.2, "color": "yellow" },
            { "value": 0.35, "color": "red" }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "PSI Alert Count (>0.2)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "count(assembled_drift_max_psi > 0.2)",
          "legendFormat": "drifted strategies"
        }
      ],
      "options": {
        "thresholds": {
          "steps": [
            { "value": null, "color": "green" },
            { "value": 1, "color": "red" }
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Max PSI Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 10 },
      "description": "Per-strategy max PSI trend. Sustained upward trend = model decay.",
      "targets": [
        {
          "expr": "assembled_drift_max_psi",
          "legendFormat": "{{strategy}} max PSI"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.2, "color": "yellow" },
              { "value": 0.35, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "PSI Threshold Reference Lines",
      "type": "text",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 3 },
      "options": {
        "content": "**PSI Thresholds:** PSI < 0.1 = negligible drift | PSI 0.1–0.2 = minor drift (monitor) | PSI 0.2–0.35 = moderate drift (reduce size) | PSI > 0.35 = major drift (pause signal). Source: `ops/drift_monitor.py`",
        "mode": "markdown"
      }
    }
  ]
}

{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Edit(/src/assembled_core/execution/**)",
      "Write(/src/assembled_core/execution/**)",
      "Edit(/src/assembled_core/risk/**)",
      "Write(/src/assembled_core/risk/**)",
      "Edit(/src/assembled_core/accounting/**)",
      "Write(/src/assembled_core/accounting/**)",
      "Edit(/src/assembled_core/pipeline/**)",
      "Write(/src/assembled_core/pipeline/**)",
      "Edit(/src/assembled_core/paper/**)",
      "Write(/src/assembled_core/paper/**)",
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)"
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/protected_paths_guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_start_load_errors.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/stop_review_chain.py"
          }
        ]
      }
    ]
  }
}
